{
  "name": "jinge-antd",
  "version": "0.0.1",
  "private": true,
  "description": "jinge 框架实现的 ant-design 组件库",
  "type": "module",
  "main": "./dist/jinge-antd.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/jinge-antd.js",
      "types": "./types/index.d.ts"
    },
    "./colors": {
      "import": "./dist/colors.js",
      "types": "./types/_tool/colors.d.ts"
    },
    "./source": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && pnpm build-types && pnpm build-lib && pnpm build-tool",
    "build-lib": "vite build -c scripts/vite.config.ts",
    "build-lib-dev": "NODE_ENV=development vite build -m development -c scripts/vite.config.ts",
    "build-site": "vite build -c scripts/vite.site.config.ts",
    "build-tool": "tsup-node --entry.colors ./src/_tool/colors.ts --format esm",
    "build-types": "tsc -project ./tsconfig.types.json",
    "dev-site": "vite dev -c scripts/vite.site.config.ts",
    "lint": "tsc --noEmit && oxlint --type-aware && oxfmt --check",
    "lint-fix": "oxlint --type-aware --fix && oxfmt",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview-site": "vite preview -c scripts/vite.site.config.mts"
  },
  "devDependencies": {
    "@ant-design/colors": "^8.0.1",
    "@iconify/json": "^2.2.517",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "jinge": "^4.1.7",
    "jinge-compiler": "^4.1.11",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sass-embedded": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "jinge": "^4.1.7",
    "zod": "^4.1.12"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ]
  }
}
