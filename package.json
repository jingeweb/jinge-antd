{
  "name": "jinge-antd",
  "description": "jinge 框架实现的 ant-design 组件库",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/jinge-antd.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/jinge-antd.js",
      "types": "./types/index.d.ts"
    },
    "./colors": {
      "import": "./dist/colors.js",
      "types": "./types/_tool/colors.d.ts"
    },
    "./source": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build-types": "tsc -project ./tsconfig.types.json",
    "build-tool": "tsup --entry.colors ./src/_tool/colors.ts --format esm",
    "build-lib-dev": "NODE_ENV=development vite build -m development -c scripts/vite.config.ts",
    "build-lib": "vite build -c scripts/vite.config.ts",
    "build": "rm -rf dist && pnpm build-types && pnpm build-lib && pnpm build-tool",
    "dev-site": "vite dev -c scripts/vite.site.config.mts",
    "build-site": "vite build -c scripts/vite.site.config.mts",
    "preview-site": "vite preview -c scripts/vite.site.config.mts",
    "lint-fix": "eslint '**/*.{js,mjs,ts}' --fix && prettier --log-level=warn --write . !*.yaml",
    "lint": "tsc --noEmit && eslint '**/*.{js,mjs,ts}' && prettier --check . !*.yaml",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@ant-design/colors": "^8.0.0",
    "@eslint/js": "^9.23.0",
    "@iconify/json": "^2.2.320",
    "@iconify/tailwind4": "^1.0.6",
    "@tailwindcss/vite": "^4.0.16",
    "@types/node": "^22.13.13",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import-x": "^4.9.2",
    "husky": "^9.1.7",
    "jinge": "link:../jinge",
    "jinge-compiler": "link:../jinge-swc-compiler",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass-embedded": "^1.86.0",
    "tailwindcss": "^4.0.16",
    "tsup": "^8.4.0",
    "type-fest": "^4.38.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.3",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "jinge": "^4.1.7",
    "zod": "^3"
  }
}
