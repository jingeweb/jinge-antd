{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "jsx": "preserve"
  },
  "include": [
    "src/**/*",
    "site/**/*",
    "scripts/**/*",
    "intl/**/*",
    "*.js",
    "*.mjs"
  ]
}
