{
  "name": "jinge-antd",
  "version": "0.0.1",
  "private": true,
  "description": "jinge 框架实现的 ant-design 组件库",
  "type": "module",
  "main": "./dist/jinge-antd.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/jinge-antd.js"
    },
    "./colors": {
      "types": "./types/_tool/colors.d.ts",
      "import": "./dist/colors.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./style.css": "./dist/jinge-antd.css"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm build-types && pnpm build-lib && pnpm build-tool",
    "build-lib": "vite build -c scripts/vite.config.ts",
    "build-lib-dev": "NODE_ENV=development vite build -m development -c scripts/vite.config.ts",
    "build-site": "vite build -c scripts/vite.site.config.ts",
    "build-tool": "tsup-node --entry.colors ./src/_tool/colors.ts --format esm",
    "build-types": "tsc -project ./tsconfig.types.json",
    "dev-site": "vite dev -c scripts/vite.site.config.ts",
    "lint": "tsc --noEmit && oxlint --type-aware && oxfmt --check",
    "lint-fix": "oxlint --type-aware --fix && oxfmt",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview-site": "vite preview -c scripts/vite.site.config.ts",
    "test": "node test/run.mjs",
    "test:components": "node test/run.mjs components",
    "test:e2e": "playwright test --config test/e2e/playwright.config.mjs",
    "test:e2e:components": "playwright test --config test/e2e/playwright.config.mjs components.spec.mjs button.spec.mjs floating.spec.mjs overlays.spec.mjs dialogs.spec.mjs notices.spec.mjs display.spec.mjs containers.spec.mjs feedback.spec.mjs inputs.spec.mjs choices.spec.mjs selects.spec.mjs forms.spec.mjs navigation.spec.mjs data.spec.mjs pickers.spec.mjs upload.spec.mjs hierarchy.spec.mjs",
    "test:e2e:regressions": "playwright test --config test/e2e/playwright.config.mjs regressions.spec.mjs",
    "test:framework": "node test/unit/run.mjs --prepare-only && node --test test/framework/*.test.mjs",
    "test:regressions": "node test/run.mjs regressions",
    "test:site": "playwright test --config test/e2e/site.config.mjs",
    "test:sync-jinge": "node scripts/sync-local-jinge.mjs",
    "test:types": "tsc --noEmit -p test/tsconfig.json",
    "test:unit": "node test/unit/run.mjs",
    "test:unit:components": "node test/unit/run.mjs components",
    "test:unit:regressions": "node test/unit/run.mjs regressions",
    "test:verify": "node test/verify.mjs"
  },
  "devDependencies": {
    "@ant-design/colors": "^8.0.1",
    "@iconify/json": "^2.2.553",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "jinge": "^4.2.1",
    "jinge-compiler": "^4.2.1",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sass-embedded": "^1.107.1",
    "tailwindcss": "^4.3.4",
    "tsup": "^9.0.0",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "jinge": "^4.2.1",
    "zod": "^4.1.12"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ]
  }
}
