{
  "name": "jinge-antd",
  "description": "jinge 框架实现的 ant-design 组件库",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/jinge-antd.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/jinge-antd.js",
      "types": "./types/index.d.ts"
    },
    "./colors": {
      "import": "./dist/colors.js",
      "types": "./types/_tool/colors.d.ts"
    },
    "./source": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build-types": "tsc -project ./tsconfig.types.json",
    "build-tool": "tsup --entry.colors ./src/_tool/colors.ts --format esm",
    "build-lib-dev": "NODE_ENV=development vite build -m development -c scripts/vite.config.ts",
    "build-lib": "vite build -c scripts/vite.config.ts",
    "build": "rm -rf dist && pnpm build-types && pnpm build-lib && pnpm build-tool",
    "dev-site": "vite dev -c scripts/vite.site.config.mts",
    "build-site": "vite build -c scripts/vite.site.config.mts",
    "preview-site": "vite preview -c scripts/vite.site.config.mts",
    "lint-fix": "oxlint --type-aware --fix && biome format --fix",
    "lint": "tsc --noEmit && oxlint --type-aware && biome format",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --type-aware --fix",
      "biome format --fix"
    ]
  },
  "devDependencies": {
    "@ant-design/colors": "^8.0.0",
    "@biomejs/biome": "^2.2.5",
    "@iconify/json": "^2.2.394",
    "@iconify/tailwind4": "^1.0.6",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.2",
    "husky": "^9.1.7",
    "jinge": "^4.1.7",
    "jinge-compiler": "^4.1.7",
    "lint-staged": "^16.2.4",
    "oxlint": "^1.22.0",
    "oxlint-tsgolint": "^0.2.0",
    "sass-embedded": "^1.93.2",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.5.0",
    "type-fest": "^5.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "jinge": "^4.1.7",
    "zod": "^4.1.12"
  }
}
