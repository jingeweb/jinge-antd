{
  "name": "jinge-antd",
  "description": "jinge 框架实现的 ant-design 组件库",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/jinge-antd.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/jinge-antd.js",
      "types": "./types/index.d.ts"
    },
    "./colors": {
      "import": "./dist/colors.js",
      "types": "./types/_tool/colors.d.ts"
    },
    "./source": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build-types": "tsc -project ./tsconfig.types.json",
    "build-tool": "tsup --entry.colors ./src/_tool/colors.ts --format esm",
    "build-lib-dev": "NODE_ENV=development vite build -m development -c scripts/vite.config.ts",
    "build-lib": "vite build -c scripts/vite.config.ts",
    "build": "rm -rf dist && pnpm build-types && pnpm build-lib && pnpm build-tool",
    "dev-site": "vite dev -c scripts/vite.site.config.mts",
    "build-site": "vite build -c scripts/vite.site.config.mts",
    "preview-site": "vite preview -c scripts/vite.site.config.mts",
    "lint-fix": "eslint \"**/*.{js,mjs,ts,tsx}\" --fix && prettier --log-level=warn --write . !*.yaml",
    "lint": "tsc --noEmit && eslint \"**/*.{js,mjs,ts,tsx}\" && prettier --check . !*.yaml",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@ant-design/colors": "^8.0.0",
    "@eslint/js": "^9.36.0",
    "@iconify/json": "^2.2.389",
    "@iconify/tailwind4": "^1.0.6",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "husky": "^9.1.7",
    "jinge": "^4.1.7",
    "jinge-compiler": "^4.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass-embedded": "^1.93.2",
    "tailwindcss": "^4.1.13",
    "tsup": "^8.5.0",
    "type-fest": "^5.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.1.11"
  },
  "peerDependencies": {
    "jinge": "^4.1.7",
    "zod": "^4"
  }
}
