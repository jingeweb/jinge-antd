{
  "name": "jinge-starter",
  "description": "jinge 框架最小化初始项目模板",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev -c scripts/vite.config.ts",
    "build-dev": "NODE_ENV=development vite build -m development -c scripts/vite.config.ts",
    "build": "vite build -c scripts/vite.config.ts",
    "preview": "vite preview",
    "lint-fix": "eslint '**/*.{js,mjs,ts}' --fix && prettier --log-level=warn --write . !*.yaml",
    "lint": "tsc --noEmit && eslint '**/*.{js,mjs,ts}' && prettier --check . !*.yaml",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/vite": "^4.0.14",
    "@types/eslint__js": "^9.14.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import-x": "^4.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.85.1",
    "tailwindcss": "^4.0.14",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "jinge": "link:../jinge",
    "jinge-compiler": "link:../jinge-swc-compiler"
  }
}
